<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ne_root"
    android:layout_width="@dimen/card_poster_width"
    android:layout_height="@dimen/card_poster_height"
    android:background="@drawable/bg_aurora_card"
    android:clipToOutline="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/ne_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <!-- Top-left "NEW" badge -->
    <TextView
        android:id="@+id/ne_badge_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:background="#E622C55E"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="NEW"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_badge"
        android:textStyle="bold" />

    <!-- Top-right gold count badge: "3 NEW" -->
    <TextView
        android:id="@+id/ne_badge_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="#CCFFC107"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_badge"
        android:textStyle="bold"
        tools:text="3 NEW" />

    <!-- Bottom title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC1A1A24"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/ne_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
