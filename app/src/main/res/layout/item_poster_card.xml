<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/poster_root"
    android:layout_width="@dimen/card_poster_width"
    android:layout_height="@dimen/card_poster_height"
    android:background="@drawable/bg_poster_card_aurora"
    android:clipToOutline="true"
    android:clipChildren="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Poster image -->
    <ImageView
        android:id="@+id/poster_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@color/aurora_bg_elevated"
        tools:ignore="ContentDescription" />

    <!-- Shimmer loading overlay (shown until image loads) -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/poster_shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1A1A24" />

    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- Bottom gradient for title readability (bottom 60%) -->
    <View
        android:id="@+id/gradient_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_poster_aurora" />

    <!-- Watched checkmark badge (top-left) -->
    <ImageView
        android:id="@+id/poster_watched_badge"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:src="@android:drawable/checkbox_on_background"
        android:tint="#FF10B981"
        android:contentDescription="Watched"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Quality badge (top-right) -->
    <TextView
        android:id="@+id/poster_quality_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:textSize="@dimen/text_badge"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:visibility="gone"
        tools:text="4K"
        tools:visibility="visible" />

    <!-- Bottom info overlay -->
    <LinearLayout
        android:id="@+id/poster_info_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Title -->
        <TextView
            android:id="@+id/poster_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <!-- "Starring {actor}" — shown only for search results that matched on cast, not title.
             Set + made visible by PosterPresenter when PosterItem.castMatch is non-null. -->
        <TextView
            android:id="@+id/poster_starring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/focus_gold"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:visibility="gone"
            tools:text="Starring Tom Hanks"
            tools:visibility="visible" />

        <!-- Rating (gold) -->
        <TextView
            android:id="@+id/poster_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/focus_gold"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:visibility="gone" />

        <!-- Metadata line (rating + quality or type) — shown on focus -->
        <TextView
            android:id="@+id/poster_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="10.5sp"
            android:textColor="#80FFFFFF"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingTop="0dp"
            android:visibility="gone" />

        <!-- Micro-CTA (Watch / Details) — shown on focus -->
        <TextView
            android:id="@+id/poster_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="10sp"
            android:textColor="#FFC107"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Watch progress bar (bottom edge) — inflated lazily. Only cards that are
         partially watched pay the cost of the themed ProgressBar; empty cards skip
         it entirely (this style resolution was the main-thread stall in the v4.2.6
         ANR traces). Inflated on demand by PosterPresenter.onBindViewHolder. -->
    <ViewStub
        android:id="@+id/poster_progress_stub"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:inflatedId="@+id/poster_progress_bar"
        android:layout="@layout/view_poster_progress" />
</FrameLayout>
