<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aurora_bg_deep">

    <!-- Layer 0: Aurora atmospheric background -->
    <View
        android:id="@+id/aurora_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 1: Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:descendantFocusability="afterDescendants"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:descendantFocusability="afterDescendants"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Hero Banner -->
            <FrameLayout
                android:id="@+id/hero_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height">

                <ImageView
                    android:id="@+id/hero_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription" />

                <!-- Bottom gradient melt -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_hero_gradient_bottom" />

                <!-- Left gradient for text readability -->
                <View
                    android:layout_width="300dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_gradient_left" />

                <!-- Hero content -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:paddingBottom="32dp">

                    <TextView
                        android:id="@+id/hero_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        tools:text="Featured Movie Title" />

                    <TextView
                        android:id="@+id/hero_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="Action, Drama • 2024" />

                    <!-- Action buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/hero_watch_now"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_watch_now_button"
                            android:paddingStart="28dp"
                            android:paddingEnd="28dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="@string/watch_now"
                            android:textColor="#FF0A0A0A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />

                        <TextView
                            android:id="@+id/hero_more_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_more_info_button"
                            android:paddingStart="28dp"
                            android:paddingEnd="28dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="More Info"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />
                    </LinearLayout>

                    <!-- Hero page indicators -->
                    <LinearLayout
                        android:id="@+id/hero_indicators"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </FrameLayout>

            <!-- Content Rows Container -->
            <LinearLayout
                android:id="@+id/rows_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/overscan_margin">

                <!-- Continue Watching Section -->
                <TextView
                    android:id="@+id/continue_watching_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="24dp"
                    android:text="@string/continue_watching"
                    android:textColor="@color/text_accent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/continue_watching_row"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:visibility="gone"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants"
                    tools:visibility="visible" />

                <!-- For You Section -->
                <TextView
                    android:id="@+id/for_you_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="24dp"
                    android:text="@string/for_you"
                    android:textColor="@color/text_accent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/for_you_row"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:visibility="gone"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants"
                    tools:visibility="visible" />

                <!-- Browse Sections -->
                <TextView
                    android:id="@+id/sections_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="24dp"
                    android:text="Browse"
                    android:textColor="@color/text_accent"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/sections_row"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants" />

                <!-- Trending Section -->
                <TextView
                    android:id="@+id/trending_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="24dp"
                    android:text="Trending Now"
                    android:textColor="@color/text_accent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/trending_row"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:visibility="gone"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants"
                    tools:visibility="visible" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Layer 2: Frosted header (on top) -->
    <LinearLayout
        android:id="@+id/frosted_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/overscan_margin"
        android:paddingEnd="@dimen/overscan_margin"
        android:background="@drawable/bg_frosted_header"
        android:alpha="0">

        <ImageView
            android:id="@+id/header_logo"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_full"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/header_center_logo"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="center"
            android:src="@drawable/logo_full"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/header_search"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_search"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:focusableInTouchMode="true"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/header_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_settings"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:focusableInTouchMode="true"
            tools:ignore="ContentDescription" />

        <TextClock
            android:id="@+id/header_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
