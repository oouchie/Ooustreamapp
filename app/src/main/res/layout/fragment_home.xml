<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aurora_bg_deep">

    <!-- Layer 0: Aurora atmospheric background -->
    <View
        android:id="@+id/aurora_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 1: Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:descendantFocusability="afterDescendants"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:descendantFocusability="afterDescendants"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Hero Banner — clipChildren + clipToPadding prevent Ken Burns overflow -->
            <FrameLayout
                android:id="@+id/hero_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:outlineProvider="bounds"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/hero_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription" />

                <!-- Hero trailer preview (auto-play on dwell) -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/hero_preview_player"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:use_controller="false"
                    app:surface_type="texture_view"
                    app:resize_mode="zoom" />

                <!-- Ambient color wash (set programmatically from Palette) -->
                <View
                    android:id="@+id/hero_ambient_wash"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0" />

                <!-- Layer 1: Top vignette (header protection) -->
                <View
                    android:id="@+id/hero_gradient_top"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_hero_gradient_top" />

                <!-- Layer 2: Bottom gradient — match_parent, gradient handles the fade -->
                <View
                    android:id="@+id/hero_gradient_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_gradient_bottom" />

                <!-- Layer 3: Left gradient for text readability (60% width) -->
                <View
                    android:id="@+id/hero_gradient_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_gradient_left" />

                <!-- Hero content overlay -->
                <LinearLayout
                    android:id="@+id/hero_content_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:paddingBottom="16dp">

                    <!-- Time-of-day greeting -->
                    <TextView
                        android:id="@+id/hero_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp"
                        android:letterSpacing="0.03"
                        android:visibility="gone"
                        tools:text="Good Evening, Marcus"
                        tools:visibility="visible" />

                    <!-- Metadata chips: rating | year | genre -->
                    <LinearLayout
                        android:id="@+id/hero_metadata_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/hero_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFC107"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="★ 8.7" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="12dp"
                            android:layout_marginHorizontal="10dp"
                            android:background="#4DFFC107" />

                        <TextView
                            android:id="@+id/hero_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#B3FFFFFF"
                            android:textSize="12sp"
                            tools:text="2024" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="12dp"
                            android:layout_marginHorizontal="10dp"
                            android:background="#4DFFC107" />

                        <TextView
                            android:id="@+id/hero_genre_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#B3FFFFFF"
                            android:textSize="12sp"
                            tools:text="Action, Crime" />
                    </LinearLayout>

                    <!-- Title (large, cinematic) -->
                    <TextView
                        android:id="@+id/hero_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        tools:text="Featured Movie Title" />

                    <!-- Genre line (kept for backward compat) -->
                    <TextView
                        android:id="@+id/hero_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Action, Drama • 2024" />

                    <!-- Description (2-line plot summary) -->
                    <TextView
                        android:id="@+id/hero_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxWidth="560dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="#99FFFFFF"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="A gripping thriller that takes you on a journey..." />

                    <!-- Action buttons row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/hero_watch_now"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_watch_now_button"
                            android:paddingStart="28dp"
                            android:paddingEnd="28dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="@string/watch_now"
                            android:textColor="#FF0A0A0A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />

                        <TextView
                            android:id="@+id/hero_more_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_more_info_button"
                            android:paddingStart="28dp"
                            android:paddingEnd="28dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="More Info"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />

                        <!-- Spacer -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- Hero page indicators (right-aligned) -->
                        <LinearLayout
                            android:id="@+id/hero_indicators"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/overscan_margin"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" />
                    </LinearLayout>
                </LinearLayout>

                <!-- clipToOutline on hero_container handles clean bottom edge -->
            </FrameLayout>

            <!-- Content Rows Container -->
            <LinearLayout
                android:id="@+id/rows_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/overscan_margin">

                <!-- Continue Watching Section -->
                <TextView
                    android:id="@+id/continue_watching_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="0dp"
                    android:text="@string/continue_watching"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/continue_watching_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/row_continue_watching_height"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:visibility="gone"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants"
                    tools:visibility="visible" />

                <!-- Live Sports / Events Banner -->
                <include
                    android:id="@+id/sports_banner"
                    layout="@layout/view_live_sports_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Top 10 Section -->
                <TextView
                    android:id="@+id/top10_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="24dp"
                    android:text="Top 10 Today"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/top10_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/row_top10_height"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:visibility="gone"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants"
                    tools:visibility="visible" />

                <!-- Pick Up & New (New Episodes + Watch It Again merged) -->
                <TextView
                    android:id="@+id/new_episodes_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="24dp"
                    android:text="Pick Up &amp; New"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/new_episodes_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/row_new_episodes_height"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:visibility="gone"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants"
                    tools:visibility="visible" />

                <!-- For You Section -->
                <TextView
                    android:id="@+id/for_you_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="24dp"
                    android:text="@string/for_you"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/for_you_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/row_for_you_height"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:visibility="gone"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants"
                    tools:visibility="visible" />

                <!-- Because You Watched Container (dynamic rows, replaces flat For You when populated) -->
                <LinearLayout
                    android:id="@+id/because_you_watched_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone" />

                <!-- For You — Live Now Section -->
                <TextView
                    android:id="@+id/for_you_live_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="24dp"
                    android:text="@string/for_you_live_now"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@id/for_you_live_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/row_for_you_live_height"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:visibility="gone"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants"
                    tools:visibility="visible" />

                <!-- Browse Sections -->
                <TextView
                    android:id="@+id/sections_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="24dp"
                    android:text="Browse"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/sections_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/row_sections_height"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants" />

                <!-- Trending Section -->
                <TextView
                    android:id="@+id/trending_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="24dp"
                    android:text="Trending Now"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/trending_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/row_trending_height"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:visibility="gone"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants"
                    tools:visibility="visible" />

                <!-- Trending Series Section -->
                <TextView
                    android:id="@+id/trending_series_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/overscan_margin"
                    android:paddingEnd="@dimen/overscan_margin"
                    android:layout_marginTop="24dp"
                    android:text="Trending Series"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/trending_series_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/row_trending_height"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/overscan_margin"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:visibility="gone"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants"
                    tools:visibility="visible" />

                <!-- Genre Rows (dynamically populated) -->
                <LinearLayout
                    android:id="@+id/genre_rows_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Watch It Again merged into the "Pick Up & New" rail near the top (v3.7.13) -->
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Layer 2: Frosted header (on top) -->
    <LinearLayout
        android:id="@+id/frosted_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/overscan_margin"
        android:paddingEnd="@dimen/overscan_margin"
        android:background="@drawable/bg_frosted_header"
        android:alpha="0">

        <ImageView
            android:id="@+id/header_logo"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_full"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/header_center_logo"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="center"
            android:src="@drawable/logo_full"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/header_search"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_search"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:focusableInTouchMode="true"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/header_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_settings"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:focusableInTouchMode="true"
            tools:ignore="ContentDescription" />

        <TextClock
            android:id="@+id/header_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
