<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:background="@color/card_bg"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Episode thumbnail -->
        <ImageView
            android:id="@+id/episode_thumbnail"
            android:layout_width="160dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:background="@color/surface"
            android:contentDescription="@null"
            android:visibility="gone" />

        <!-- Episode info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <!-- Episode number + title row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Watched checkmark -->
                <ImageView
                    android:id="@+id/episode_watched_check"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:tint="#FF10B981"
                    android:contentDescription="Watched"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/episode_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/focus_gold"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="E1" />

                <TextView
                    android:id="@+id/episode_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Pilot" />

                <TextView
                    android:id="@+id/episode_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    tools:text="Mar 15, 2024"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/episode_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    tools:text="58 min"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Plot description -->
            <TextView
                android:id="@+id/episode_plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                android:visibility="gone"
                tools:text="A high school chemistry teacher is diagnosed with inoperable lung cancer..."
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Watch progress bar (bottom edge) -->
    <ProgressBar
        android:id="@+id/episode_progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progress="0"
        android:progressTint="#FF10B981"
        android:progressBackgroundTint="#33FFFFFF"
        android:visibility="gone"
        tools:progress="450"
        tools:visibility="visible" />

</FrameLayout>
