<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Scrim overlay to dim background -->
    <View
        android:id="@+id/sidebar_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"/>

    <!-- Sidebar panel -->
    <LinearLayout
        android:id="@+id/sidebar_panel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#E6101820"
        android:paddingTop="@dimen/overscan_horizontal"
        android:paddingBottom="@dimen/overscan_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:translationX="-280dp"
        android:elevation="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- Logo -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_launcher_foreground"
            android:layout_marginBottom="32dp"
            android:scaleType="fitStart"
            android:contentDescription="Ooustream logo"/>

        <!-- Section shortcuts container -->
        <LinearLayout
            android:id="@+id/sidebar_shortcuts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"/>

        <!-- Connection status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp">

            <View
                android:id="@+id/connection_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_card_rounded"/>

            <TextView
                android:id="@+id/connection_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:text="Connected"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
