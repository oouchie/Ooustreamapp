<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cw_root"
    android:layout_width="@dimen/card_poster_width"
    android:layout_height="@dimen/card_poster_height"
    android:background="@drawable/bg_aurora_card"
    android:clipToOutline="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/cw_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC1A1A24"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/cw_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cw_resume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_accent"
            android:textSize="12sp"
            tools:text="S3 E3 · 26m left" />
    </LinearLayout>

    <!-- Progress bar overlays the bottom edge of the poster -->
    <ProgressBar
        android:id="@+id/cw_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:max="100"
        android:progressDrawable="@drawable/progress_continue_watching" />
</FrameLayout>
