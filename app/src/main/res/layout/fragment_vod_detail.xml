<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Backdrop image (full width, top portion) -->
    <ImageView
        android:id="@+id/vod_backdrop"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Gradient overlay on backdrop -->
    <View
        android:id="@+id/backdrop_gradient"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/gradient_series_backdrop" />

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <!-- Info section overlaying the backdrop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingTop="140dp"
                android:gravity="bottom">

                <!-- Cover poster -->
                <ImageView
                    android:id="@+id/vod_cover"
                    android:layout_width="140dp"
                    android:layout_height="210dp"
                    android:scaleType="centerCrop"
                    android:background="@color/card_bg"
                    android:contentDescription="@null" />

                <!-- Movie metadata -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:layout_gravity="bottom">

                    <TextView
                        android:id="@+id/vod_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="The Shawshank Redemption" />

                    <!-- Rating + Genre + Year + Duration row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/vod_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/focus_gold"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="★ 9.3"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/vod_genre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:layout_marginStart="12dp"
                            android:visibility="gone"
                            tools:text="Drama"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/vod_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"
                            android:layout_marginStart="12dp"
                            android:visibility="gone"
                            tools:text="1994"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/vod_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"
                            android:layout_marginStart="12dp"
                            android:visibility="gone"
                            tools:text="2h 22m"
                            tools:visibility="visible" />

                    </LinearLayout>

                    <!-- Director -->
                    <TextView
                        android:id="@+id/vod_director"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone"
                        tools:text="Director: Frank Darabont"
                        tools:visibility="visible" />

                    <!-- Cast -->
                    <TextView
                        android:id="@+id/vod_cast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="gone"
                        tools:text="Cast: Tim Robbins, Morgan Freeman"
                        tools:visibility="visible" />

                    <!-- Plot -->
                    <TextView
                        android:id="@+id/vod_plot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="10dp"
                        android:maxLines="5"
                        android:ellipsize="end"
                        android:lineSpacingMultiplier="1.3"
                        android:visibility="gone"
                        tools:text="Two imprisoned men bond over a number of years, finding solace and eventual redemption through acts of common decency."
                        tools:visibility="visible" />

                    <!-- Play button -->
                    <Button
                        android:id="@+id/vod_play_button"
                        android:layout_width="180dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:text="Play"
                        android:textColor="@color/background"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/focus_gold"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@id/vod_play_button"
                        android:nextFocusLeft="@id/vod_play_button" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/focus_gold"
        android:visibility="gone" />

</FrameLayout>
