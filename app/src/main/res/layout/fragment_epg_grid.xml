<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/overscan_margin"
        android:paddingEnd="@dimen/overscan_margin"
        android:paddingTop="24dp"
        android:paddingBottom="@dimen/overscan_margin">

        <!-- Header: title + category + clock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/guide_category_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:nextFocusDown="@+id/guide_rows" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm a"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Time ruler (GuideTimeHeaderView added programmatically) -->
        <FrameLayout
            android:id="@+id/guide_time_header_container"
            android:layout_width="match_parent"
            android:layout_height="26dp" />

        <!-- Channel rows -->
        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/guide_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:clipToPadding="false" />

        <!-- Key hints -->
        <TextView
            android:id="@+id/guide_hints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/guide_hints"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
