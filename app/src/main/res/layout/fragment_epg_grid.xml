<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/overscan_margin"
        android:paddingEnd="@dimen/overscan_margin"
        android:paddingTop="18dp"
        android:paddingBottom="@dimen/overscan_margin">

        <!-- ===== NOW PLAYING HEADER (collapsible via Full Screen) ===== -->
        <LinearLayout
            android:id="@+id/guide_header"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- Live preview (tiered: video on capable devices, glyph otherwise) -->
            <FrameLayout
                android:id="@+id/epg_preview_frame"
                android:layout_width="284dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_preview_frame"
                android:clipToOutline="true">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/epg_preview_player_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/epg_preview_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#66FFFFFF"
                    android:textSize="40sp" />
            </FrameLayout>

            <!-- Program info panel -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Title row: logo + title/subtitle + favorite indicator -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <ImageView
                            android:id="@+id/epg_header_logo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/epg_header_initials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/epg_header_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/epg_header_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/epg_header_favorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/guide_favorite"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- On-now title -->
                <TextView
                    android:id="@+id/epg_header_now_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Time range + live progress + remaining -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/epg_header_now_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:id="@+id/epg_header_progress_container"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="#33FFFFFF">

                        <View
                            android:id="@+id/epg_header_progress_fill"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@color/focus_gold" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/epg_header_now_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Description (1 line) -->
                <TextView
                    android:id="@+id/epg_header_now_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Up next -->
                <TextView
                    android:id="@+id/epg_header_next_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== TOOLBAR ===== -->
        <LinearLayout
            android:id="@+id/guide_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/guide_category_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_guide_pill"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:nextFocusDown="@+id/guide_rows" />

            <TextView
                android:id="@+id/guide_btn_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="6dp"
                android:background="@drawable/bg_guide_pill"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:text="@string/guide_search"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:nextFocusDown="@+id/guide_rows" />

            <TextView
                android:id="@+id/guide_btn_fullscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_guide_pill"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:text="@string/guide_full_screen"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:nextFocusDown="@+id/guide_rows" />

            <TextView
                android:id="@+id/guide_btn_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minHeight="40dp"
                android:minWidth="56dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_guide_pill"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:text="2h"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:nextFocusDown="@+id/guide_rows" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/guide_btn_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_guide_pill"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:text="@string/guide_now"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:nextFocusDown="@+id/guide_rows" />

            <TextView
                android:id="@+id/guide_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Time ruler (GuideTimeHeaderView added programmatically) -->
        <FrameLayout
            android:id="@+id/guide_time_header_container"
            android:layout_width="match_parent"
            android:layout_height="26dp" />

        <!-- Channel rows -->
        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/guide_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:clipToPadding="false" />

        <!-- Key hints -->
        <TextView
            android:id="@+id/guide_hints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/guide_hints"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
