<?xml version="1.0" encoding="utf-8"?>
<!-- Trending rank card: large rank number behind poster card -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/card_poster_width"
    android:layout_height="@dimen/card_poster_height"
    android:foreground="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_marginEnd="12dp">

    <!-- Large rank number (behind poster) -->
    <TextView
        android:id="@+id/rank_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="#55FFFFFF"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:layout_marginBottom="-4dp"
        tools:text="1" />

    <!-- Poster card area (offset right to show rank) -->
    <FrameLayout
        android:id="@+id/poster_frame"
        android:layout_width="140dp"
        android:layout_height="210dp"
        android:layout_gravity="end|top"
        android:background="@drawable/bg_poster_card_aurora"
        android:clipToOutline="true"
        android:clipChildren="true"
        android:outlineProvider="background">

        <!-- Poster image -->
        <ImageView
            android:id="@+id/trending_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/aurora_bg_elevated"
            tools:ignore="ContentDescription" />

        <!-- Bottom gradient -->
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_poster_aurora" />

        <!-- Quality badge (top-right) -->
        <TextView
            android:id="@+id/trending_quality_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:textSize="@dimen/text_badge"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:visibility="gone"
            tools:text="HD" />

        <!-- Bottom info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/trending_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                tools:text="Movie Title" />

            <TextView
                android:id="@+id/trending_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/focus_gold"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                tools:text="★ 7.5" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
