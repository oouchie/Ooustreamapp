<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="30dp"
    android:background="@drawable/bg_multiview_scrim_top">

    <!-- Left: Logo + MultiView label -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OOUSTREAM"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="-0.03" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="10dp"
            android:background="#33FFD700" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MultiView"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="PRO"
            android:textColor="#FFD700"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:background="@drawable/bg_pro_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- Center: Layout selector -->
    <LinearLayout
        android:id="@+id/layout_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/bg_layout_selector"
        android:padding="3dp">

        <TextView
            android:id="@+id/btn_layout_quad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2x2"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btn_layout_main3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1+3"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btn_layout_dual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dual"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btn_layout_triple"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Triple"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true" />
    </LinearLayout>

    <!-- Right: Status + Clock -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <View
            android:id="@+id/status_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_status_dot_green" />

        <TextView
            android:id="@+id/stream_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0 Streams Active"
            android:textColor="#66FFFFFF"
            android:textSize="10sp" />

        <android.widget.TextClock
            android:id="@+id/top_bar_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:format12Hour="hh:mm a"
            android:textColor="#4DFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
