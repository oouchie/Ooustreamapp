<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:padding="@dimen/overscan_horizontal">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Parental Controls"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ON"
            android:textSize="14sp"
            android:textColor="#22C55E"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage content restrictions for this device"
        android:textSize="13sp"
        android:textColor="#80FFFFFF"
        android:layout_marginBottom="24dp" />

    <!-- Section Tabs -->
    <LinearLayout
        android:id="@+id/tab_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tab_live"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Live TV"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_tab_active"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <TextView
            android:id="@+id/tab_vod"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Movies"
            android:textSize="14sp"
            android:textColor="#80FFFFFF"
            android:background="@drawable/bg_tab_inactive"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <TextView
            android:id="@+id/tab_series"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Series"
            android:textSize="14sp"
            android:textColor="#80FFFFFF"
            android:background="@drawable/bg_tab_inactive"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <!-- Section header: blocked count -->
    <TextView
        android:id="@+id/section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#80FFFFFF"
        android:layout_marginBottom="8dp" />

    <!-- Category list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/category_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Quick Actions — equal thirds (0dp + weight) so the three buttons share the row width and
         never clip off the edges on a narrow phone (was wrap_content + gravity=center, which
         pushed "Block All Adult" and "Change PIN" past both edges). 48dp tall = Material touch. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_block_adult"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Block All Adult"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_action_button_red"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_allow_all"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Allow All"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_action_button_green"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_change_pin"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Change PIN"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_action_button_gold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
