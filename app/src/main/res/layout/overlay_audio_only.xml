<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A0A">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Audio icon -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_audio_only"
            android:tint="@color/brand_cyan"
            android:layout_marginBottom="24dp"
            android:contentDescription="Audio only icon"/>

        <!-- Stream name -->
        <TextView
            android:id="@+id/audio_stream_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- Audio Only label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio Only Mode"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"/>

        <!-- Simple animated equalizer bars -->
        <LinearLayout
            android:id="@+id/equalizer_bars"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="32dp"/>

    </LinearLayout>
</FrameLayout>
