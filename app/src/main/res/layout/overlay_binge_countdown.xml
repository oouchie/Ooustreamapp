<?xml version="1.0" encoding="utf-8"?>
<!-- End-of-episode Watch Next card (2026-09-24 redesign). No full-screen scrim: the credits stay
     visible. The countdown is the gold fill draining out of the Play button (binge_drain). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/binge_card"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="48dp"
        android:orientation="vertical"
        android:background="@drawable/sd_card_bg"
        android:padding="20dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/binge_thumb"
                android:layout_width="176dp"
                android:layout_height="99dp"
                android:scaleType="centerCrop"
                android:background="@drawable/sd_card_btn"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/binge_countdown_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sd_text_secondary"
                    android:textSize="15sp"
                    tools:text="Next episode" />

                <TextView
                    android:id="@+id/binge_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/sd_text"
                    android:textSize="34sp"
                    tools:text="4" />

                <TextView
                    android:id="@+id/binge_next_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/sd_text"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Fasting" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:clipChildren="false">

            <FrameLayout
                android:id="@+id/binge_play_now"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/sd_card_btn"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <View
                    android:id="@+id/binge_drain"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:background="@drawable/sd_drain" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/binge_play_now"
                    android:textColor="@color/sd_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/binge_cancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/sd_card_btn"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/sd_text_secondary"
                android:textSize="18sp"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
