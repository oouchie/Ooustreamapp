<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sort_dropdown"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/sort_recently_added"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Recently Added"
        android:textColor="@color/focus_gold"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:focusable="true" />

    <TextView
        android:id="@+id/sort_recently_watched"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Recently Watched"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:focusable="true" />

    <TextView
        android:id="@+id/sort_name_az"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Name A-Z"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:focusable="true" />

    <TextView
        android:id="@+id/sort_category"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Category"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:focusable="true" />

</LinearLayout>
