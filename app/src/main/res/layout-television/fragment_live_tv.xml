<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aurora_bg_deep">

    <!-- Layer 0: Aurora atmospheric background -->
    <View
        android:id="@+id/aurora_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 1: Main Content (padded for overscan + header) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/overscan_margin"
        android:paddingEnd="@dimen/overscan_margin"
        android:paddingBottom="@dimen/overscan_margin"
        android:paddingTop="@dimen/screen_top_clearance">

        <!-- 3-Panel Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Categories Panel (22%) - Glass Card -->
            <LinearLayout
                android:id="@+id/categories_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="22"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_panel"
                android:padding="6dp"
                android:layout_marginEnd="8dp"
                android:clipToPadding="false"
                android:clipChildren="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categories_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:nextFocusRight="@+id/channels_list"
                    android:nextFocusUp="@+id/header_search_icon" />
            </LinearLayout>

            <!-- Channels Panel (33%) - Glass Card -->
            <FrameLayout
                android:id="@+id/channels_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="33"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_glass_panel"
                android:padding="6dp"
                android:clipToPadding="false"
                android:clipChildren="false">

                <androidx.leanback.widget.VerticalGridView
                    android:id="@+id/channels_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:nextFocusLeft="@+id/categories_list"
                    android:nextFocusRight="@+id/preview_container"
                    android:nextFocusUp="@+id/header_search_icon" />
            </FrameLayout>

            <!-- Preview + EPG Panel (45%) - Glass Card -->
            <LinearLayout
                android:id="@+id/preview_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="45"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <!-- Video Preview (60%) - Cinematic frame -->
                <FrameLayout
                    android:id="@+id/preview_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="60"
                    android:background="@drawable/bg_preview_frame"
                    android:clipToOutline="true"
                    android:focusable="false"
                    android:nextFocusLeft="@+id/channels_list"
                    android:nextFocusUp="@+id/channels_list"
                    android:nextFocusDown="@+id/channels_list">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/preview_player_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- Affordance, not instruction: a play glyph while idle -->
                    <TextView
                        android:id="@+id/preview_placeholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="▶"
                        android:textColor="@color/text_muted"
                        android:alpha="0.5"
                        android:textSize="44sp" />

                    <!-- Now-playing overlay: channel + on-now + live progress -->
                    <LinearLayout
                        android:id="@+id/preview_info_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:background="@drawable/bg_hero_gradient_bottom"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="22dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/preview_channel_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/preview_now_playing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="@color/focus_gold"
                            android:textSize="13sp" />

                        <FrameLayout
                            android:id="@+id/preview_progress_container"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="7dp"
                            android:background="#33FFFFFF"
                            android:visibility="gone">

                            <View
                                android:id="@+id/preview_progress_fill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@color/focus_gold" />
                        </FrameLayout>
                    </LinearLayout>
                </FrameLayout>

                <!-- EPG Programs (40%) - Glass Card -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/epg_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="40"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_epg_aurora"
                    android:clipToPadding="false"
                    android:clipToOutline="true"
                    android:padding="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Layer 2: Frosted Glass Header (on top) -->
    <LinearLayout
        android:id="@+id/frosted_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/overscan_margin"
        android:paddingEnd="@dimen/overscan_margin"
        android:background="@drawable/bg_livetv_header">

        <ImageView
            android:id="@+id/header_logo"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_full"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/header_center_logo"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_full"
            android:contentDescription="@string/app_name" />

        <TextClock
            android:id="@+id/header_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm a"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/header_search_input"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Search channels..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/header_search_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:padding="2dp"
            android:src="@drawable/ic_search"
            android:scaleType="centerInside"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:contentDescription="Search"
            android:nextFocusDown="@+id/channels_list"
            android:nextFocusLeft="@+id/header_clock"
            android:nextFocusRight="@+id/header_guide_icon" />

        <ImageView
            android:id="@+id/header_guide_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:padding="2dp"
            android:src="@drawable/ic_guide"
            android:scaleType="centerInside"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:contentDescription="TV Guide"
            android:nextFocusDown="@+id/channels_list"
            android:nextFocusLeft="@+id/header_search_icon"
            android:nextFocusRight="@+id/header_multiview_icon" />

        <ImageView
            android:id="@+id/header_multiview_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:padding="2dp"
            android:src="@drawable/ic_multiview_grid"
            android:scaleType="centerInside"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:contentDescription="MultiView"
            android:nextFocusDown="@+id/channels_list"
            android:nextFocusLeft="@+id/header_guide_icon" />
    </LinearLayout>
</FrameLayout>
