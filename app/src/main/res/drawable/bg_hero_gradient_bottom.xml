<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Steep gradient: hits full opacity at 60% down, solid dark for bottom 40% -->
