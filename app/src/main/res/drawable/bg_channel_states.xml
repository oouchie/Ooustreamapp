<?xml version="1.0" encoding="utf-8"?>
<!-- Channel item state selector: framework handles focus transitions
     with cached drawables — no programmatic setBackgroundResource() needed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_channel_aurora_focused" />
    <item android:drawable="@drawable/bg_channel_aurora" />
</selector>
