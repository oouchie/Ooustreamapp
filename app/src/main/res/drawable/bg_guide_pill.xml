<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: gold border + soft gold fill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#1AFFC107" />
            <stroke android:width="2dp" android:color="#FFFFC107" />
        </shape>
    </item>
    <!-- Active/selected (e.g. current Hours value): subtle gold tint -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#14FFC107" />
            <stroke android:width="1dp" android:color="#66FFC107" />
        </shape>
    </item>
    <!-- Default: glassy outline -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
