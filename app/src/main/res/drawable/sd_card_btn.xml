<?xml version="1.0" encoding="utf-8"?>
<!-- Watch Next card buttons: raised surface, gold ring on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sd_surface_raised" />
            <stroke android:width="2dp" android:color="@color/sd_gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sd_surface_raised" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
