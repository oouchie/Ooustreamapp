<?xml version="1.0" encoding="utf-8"?>
<!-- Filter tab state-list: selected=gold gradient, focused=glass+gold border, default=glass -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected + Focused -->
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33FFC107"
                android:endColor="#1AFFC107"
                android:angle="135" />
            <stroke android:width="1dp" android:color="#FFC107" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Selected -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#29FFC107"
                android:endColor="#14FFC107"
                android:angle="135" />
            <stroke android:width="1dp" android:color="#99FFC107" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#FFC107" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</selector>
